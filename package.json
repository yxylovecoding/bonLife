{
  "name": "monthlybills",
  "private": true,
  "version": "1.0.29",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/check-api-functions.mjs && node scripts/check-api-imports.mjs && node scripts/check-boncal-boundary.mjs",
    "build": "tsc -b && vite build",
    "build:deploy": "npm run build && node scripts/build-server.mjs",
    "start": "node dist-server/index.js",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "benchmark:cpu": "node --import tsx scripts/benchmark-cpu.ts",
    "test": "vitest run",
    "storage:migrate": "tsx scripts/migrate-storage.ts",
    "storage:verify": "tsx scripts/verify-storage.ts",
    "preview": "vite preview",
    "schwab:login": "node scripts/schwab.mjs login",
    "schwab:refresh": "node scripts/schwab.mjs refresh",
    "schwab:sync": "node scripts/schwab.mjs sync"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@libsql/client": "0.18.0",
    "@vercel/kv": "^3.0.0",
    "ical.js": "2.2.1",
    "lunar-typescript": "1.8.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^3.8.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^5.7.13",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.21.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "4.20.6",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^3.2.7",
    "xlsx": "^0.18.5"
  }
}
